rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['en', 'am', 'om', 'ti', 'so'];
    }

    function isValidThemeMode(mode) {
      return mode is string && mode in ['system', 'light', 'dark'];
    }

    function isValidToolMode(mode) {
      return mode is string && mode in ['general', 'translator', 'tutor', 'business', 'coder', 'culture', 'vision'];
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 120)) &&
             isValidLanguage(data.preferredLanguage) &&
             isValidThemeMode(data.themeMode) &&
             data.voiceAutoSpeak is bool;
    }

    function isValidConversation(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             isValidToolMode(data.toolMode) &&
             isValidLanguage(data.language) &&
             data.lastMessagePreview is string &&
             data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int &&
             data.messageCount >= 0 &&
             data.messageCount <= 10000;
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.role is string &&
             data.role in ['user', 'model'] &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 32000 &&
             isValidToolMode(data.toolMode) &&
             data.hasImage is bool;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'themeMode', 'voiceAutoSpeak', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'preferredLanguage', 'themeMode', 'voiceAutoSpeak', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming()) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'preferredLanguage', 'themeMode', 'voiceAutoSpeak', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /conversations/{conversationId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(conversationId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(conversationId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'toolMode', 'language', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'toolMode', 'language', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         isValidConversation(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(conversationId) &&
                         request.auth.uid == userId &&
                         isValidConversation(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'toolMode', 'language', 'lastMessagePreview', 'messageCount', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(conversationId) && request.auth.uid == userId;

        match /messages/{messageId} {
          allow get: if isSignedIn() && isValidId(userId) && isValidId(conversationId) && isValidId(messageId) && request.auth.uid == userId;
          allow list: if isSignedIn() && isValidId(userId) && isValidId(conversationId) && request.auth.uid == userId;

          allow create: if isSignedIn() &&
                           isValidId(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           request.auth.uid == userId &&
                           (exists(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId)) ||
                            existsAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId))) &&
                           incoming().keys().hasAll(['userId', 'role', 'text', 'toolMode', 'hasImage', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'role', 'text', 'toolMode', 'hasImage', 'createdAt']) &&
                           isValidChatMessage(incoming(), userId) &&
                           isValidTimestamp(incoming().createdAt);

          allow update: if false;

          allow delete: if isSignedIn() && isValidId(userId) && isValidId(conversationId) && isValidId(messageId) && request.auth.uid == userId;
        }
      }
    }
  }
}
